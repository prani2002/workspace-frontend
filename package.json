{
  "name": "fde-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "guard": "node scripts/guard.mjs",
    "check": "npm run typecheck && npm run guard && npm test && vite build",
    "check:fast": "npm run typecheck && npm run guard",
    "api:sync": "node scripts/sync-contract.mjs && npm run api:types",
    "api:types": "openapi-typescript api/openapi.yaml -o src/api/schema.d.ts",
    "set-api": "node scripts/set-api.mjs",
    "audit:deps": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "react": "^18.3.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.7.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
